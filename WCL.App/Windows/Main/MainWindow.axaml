<shadUi:Window xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:shadUi="clr-namespace:ShadUI;assembly=ShadUI"
               xmlns:main="clr-namespace:WCL.App.Views.Main"
               x:Class="WCL.App.Windows.Main.MainWindow"
               x:DataType="main:MainViewModel"
               Title="WCL"
               MinWidth="800"
               Width="800"
               MinHeight="650"
               Height="650"
               WindowStartupLocation="CenterScreen">
    <shadUi:Window.RightWindowTitleBarContent>
        <Button Width="30"
                Height="30"
                ToolTip.Tip="Сменить тему"
                Command="{Binding SwitchThemeCommand}">
            <TextBlock Text="{Binding CurrentIcon}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Button>
    </shadUi:Window.RightWindowTitleBarContent>

    <shadUi:Window.Hosts>
        <shadUi:DialogHost Manager="{Binding DialogManager}" />
        <shadUi:ToastHost Manager="{Binding ToastManager}" />
    </shadUi:Window.Hosts>

    <main:MainView />

</shadUi:Window>
