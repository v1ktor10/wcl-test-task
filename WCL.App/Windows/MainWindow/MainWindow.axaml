<shadUi:Window xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:main="clr-namespace:WCL.App.Views.Main"
               xmlns:shadUi="clr-namespace:ShadUI;assembly=ShadUI"
               x:Class="WCL.App.Windows.MainWindow.MainWindow"
               x:DataType="main:MainViewModel"
               Title="WCL"
               Width="800"
               Height="650"
               WindowStartupLocation="CenterScreen"
               CanResize="False">
    <shadUi:Window.RightWindowTitleBarContent>
        <Button Width="30" Height="30"
                CornerRadius="{DynamicResource MdCornerRadius}"
                ToolTip.Tip="Change Theme"
                Click="OnSwitchThemeClick">
            <TextBlock Text="◐" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
    </shadUi:Window.RightWindowTitleBarContent>

    <main:MainView />

</shadUi:Window>
