<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WCL.App.Views.About"
             xmlns:shadUi="clr-namespace:ShadUI;assembly=ShadUI"
             mc:Ignorable="d"
             x:Class="WCL.App.Views.About.AboutView"
             x:DataType="vm:AboutViewModel">
    <shadUi:Card HorizontalAlignment="Stretch">
        <StackPanel Spacing="6">
            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Role}" />
            <TextBlock Text="{Binding Stack, StringFormat='Стек: {0}'}" />
            <TextBlock Text="{Binding Contacts, StringFormat='tg: {0}'}" />
        </StackPanel>
    </shadUi:Card>
</UserControl>
