<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:register="clr-namespace:WCL.App.Views.Register"
             xmlns:shadUi="clr-namespace:ShadUI;assembly=ShadUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WCL.App.Views.Register.RegisterView"
             x:DataType="register:RegisterViewModel">
    <Panel>
        <StackPanel Spacing="20" Width="340" Margin="0, 8">
            <TextBlock Text="Регистрация" FontSize="18" FontWeight="SemiBold" />

            <StackPanel Spacing="10">
                <TextBox Text="{Binding Email}" PlaceholderText="Email" />
                <TextBox Text="{Binding Name}" PlaceholderText="Имя" />
                <TextBox Text="{Binding Password}" PlaceholderText="Пароль (от 8 символов)"
                         PasswordChar="●" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="Outline" Content="Отмена" Command="{Binding CancelCommand}" />
                <Button Classes="Primary" Content="Зарегистрироваться"
                        Command="{Binding SubmitCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
        <shadUi:BusyArea IsBusy="{Binding IsLoading}" />
    </Panel>
</UserControl>
