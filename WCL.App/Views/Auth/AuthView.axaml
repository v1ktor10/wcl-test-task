<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:auth="clr-namespace:WCL.App.Views.Auth"
             xmlns:shadUi="clr-namespace:ShadUI;assembly=ShadUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WCL.App.Views.Auth.AuthView"
             x:DataType="auth:AuthViewModel">
    <shadUi:Card MinWidth="320">
        <Panel>
            <StackPanel Spacing="8">
                <StackPanel IsVisible="{Binding !IsAuthenticated}"
                            IsEnabled="{Binding !IsLoading}"
                            Orientation="Vertical" Spacing="8">
                    <TextBox Text="{Binding Email}" PlaceholderText="Email" />
                    <TextBox Text="{Binding Password}" PlaceholderText="Пароль" PasswordChar="●" />
                    <Button Classes="Primary" Content="Войти"
                            Command="{Binding LoginCommand}" IsDefault="True" />
                    <Button Classes="Outline" Content="Регистрация"
                            Command="{Binding RegisterCommand}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsAuthenticated}"
                            IsEnabled="{Binding !IsLoading}"
                            Orientation="Vertical" Spacing="8">
                    <TextBlock Text="{Binding UserName}" VerticalAlignment="Center" />
                    <Button Classes="Outline" Content="Выйти" Command="{Binding LogoutCommand}" />
                </StackPanel>
            </StackPanel>
            <shadUi:BusyArea
                IsBusy="{Binding IsLoading}" />
        </Panel>
    </shadUi:Card>
</UserControl>
