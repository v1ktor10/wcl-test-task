<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WCL.App.Views.Profile"
             xmlns:shadUi="clr-namespace:ShadUI;assembly=ShadUI"
             x:Class="WCL.App.Views.Profile.ProfileView"
             x:DataType="vm:ProfileViewModel">
    <Panel>
        <TextBlock IsVisible="{Binding !IsAuthenticated}" TextWrapping="Wrap"
                   Text="Войдите, чтобы увидеть данные профиля." />

        <shadUi:Card IsVisible="{Binding IsAuthenticated}"
                     HorizontalAlignment="Left">
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding User.Name}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding User.Email}" />
                <TextBlock Text="{Binding User.Role, StringFormat='Роль: {0}'}" />
                <TextBlock Text="{Binding User.Id, StringFormat='ID: {0}'}" />
            </StackPanel>
        </shadUi:Card>
    </Panel>
</UserControl>
